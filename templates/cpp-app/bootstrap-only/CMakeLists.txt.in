cmake_minimum_required(VERSION 3.28)
project(@CMAKE_PROJECT_NAME@ VERSION 0.1.0 LANGUAGES CXX)

list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_SOURCE_DIR}/cmake/qiven")
include(QivenBuild)
qiven_project_defaults()

option(@TEST_OPTION_NAME@ "Build @REPOSITORY_NAME@ tests" ON)

add_executable(@CMAKE_TARGET_NAME@ app/main.cpp)
add_executable(@CMAKE_ALIAS@ ALIAS @CMAKE_TARGET_NAME@)
qiven_target_defaults(@CMAKE_TARGET_NAME@ SCOPE PRIVATE FOLDER "Applications")

if(@TEST_OPTION_NAME@)
    enable_testing()
endif()
