@echo off
setlocal EnableExtensions EnableDelayedExpansion
set "ROOT=%~dp0.."
set "LOCAL_CANDIDATES=%TEMP%\qiven-local-branches-%RANDOM%-%RANDOM%.txt"
set "REMOTE_CANDIDATES=%TEMP%\qiven-remote-branches-%RANDOM%-%RANDOM%.txt"
where git >nul 2>nul || goto :error_before_pushd
pushd "%ROOT%" || goto :error_before_pushd
for /f "delims=" %%R in ('git rev-parse --show-toplevel 2^>nul') do set "GIT_ROOT=%%R"
if not defined GIT_ROOT goto :error
for %%R in ("%ROOT%") do set "EXPECTED_ROOT=%%~fR"
for %%R in ("!GIT_ROOT!") do set "GIT_ROOT=%%~fR"
if /I not "!GIT_ROOT!"=="!EXPECTED_ROOT!" goto :error
git remote get-url origin >nul 2>nul || goto :error
git diff --quiet || goto :error
git diff --cached --quiet || goto :error
git switch main || goto :error
git fetch origin --prune || goto :error
git pull --ff-only origin main || goto :error
git fetch origin --prune || goto :error
git show-ref --verify --quiet refs/heads/main || goto :error
git show-ref --verify --quiet refs/remotes/origin/main || goto :error
type nul >"%LOCAL_CANDIDATES%"
type nul >"%REMOTE_CANDIDATES%"
for /f "delims=" %%B in ('git for-each-ref --format^="%%(refname)" refs/heads/') do if /I not "%%B"=="refs/heads/main" echo %%B>>"%LOCAL_CANDIDATES%"
for /f "delims=" %%R in ('git for-each-ref --format^="%%(refname)" refs/remotes/origin/') do (
    git symbolic-ref -q "%%R" >nul 2>nul
    if errorlevel 1 (
        set "REMOTE_REF=%%R"
        if /I "!REMOTE_REF:~0,20!"=="refs/remotes/origin/" (
            set "REMOTE_BRANCH=!REMOTE_REF:~20!"
            if defined REMOTE_BRANCH if /I not "!REMOTE_BRANCH!"=="main" if /I not "!REMOTE_BRANCH!"=="HEAD" echo !REMOTE_REF!>>"%REMOTE_CANDIDATES%"
        )
    )
)
set "BLOCKED=0"
for /f "usebackq delims=" %%B in ("%LOCAL_CANDIDATES%") do git merge-base --is-ancestor "%%B" refs/heads/main >nul 2>nul || (echo [Qiven] BLOCKED unmerged local branch: %%B& set "BLOCKED=1")
for /f "usebackq delims=" %%R in ("%REMOTE_CANDIDATES%") do git merge-base --is-ancestor "%%R" refs/remotes/origin/main >nul 2>nul || (echo [Qiven] BLOCKED unmerged remote branch: %%R& set "BLOCKED=1")
if "!BLOCKED!"=="1" goto :error
for /f "usebackq delims=" %%B in ("%LOCAL_CANDIDATES%") do set "LOCAL_REF=%%B"& git branch -d -- "!LOCAL_REF:~11!" || goto :error
for /f "usebackq delims=" %%R in ("%REMOTE_CANDIDATES%") do (
    set "REMOTE_REF=%%R"
    if /I not "!REMOTE_REF:~0,20!"=="refs/remotes/origin/" goto :error
    set "REMOTE_BRANCH=!REMOTE_REF:~20!"
    if not defined REMOTE_BRANCH goto :error
    if /I "!REMOTE_BRANCH!"=="main" goto :error
    if /I "!REMOTE_BRANCH!"=="HEAD" goto :error
    git push origin --delete "!REMOTE_BRANCH!" || goto :error
)
git fetch origin --prune || goto :error
del /q "%LOCAL_CANDIDATES%" "%REMOTE_CANDIDATES%" >nul 2>nul
popd
echo [Qiven] Branch cleanup completed successfully.
exit /b 0
:error
del /q "%LOCAL_CANDIDATES%" "%REMOTE_CANDIDATES%" >nul 2>nul
popd
:error_before_pushd
echo [Qiven] Branch cleanup failed. No deletion occurs before the complete merge preflight passes.
exit /b 1
