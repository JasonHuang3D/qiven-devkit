name: CI

run-name: CI / ${{ inputs.jobs }}

on:
  workflow_dispatch:
    inputs:
      jobs:
        description: "Validation units: full, windows, linux, macos"
        required: true
        default: full
        type: string

permissions:
  contents: read

jobs:
  plan:
    name: Validation plan
    runs-on: ubuntu-24.04
    outputs:
      windows: ${{ steps.plan.outputs.windows }}
      linux: ${{ steps.plan.outputs.linux }}
      macos: ${{ steps.plan.outputs.macos }}
    steps:
      - id: plan
        shell: bash
        env:
          REQUESTED: ${{ inputs.jobs }}
        run: |
          case "$REQUESTED" in
            full) selected="windows linux macos" ;;
            windows|linux|macos) selected="$REQUESTED" ;;
            *) echo "Unknown validation unit: $REQUESTED" >&2; exit 1 ;;
          esac
          for unit in windows linux macos; do
            if [[ " $selected " == *" $unit "* ]]; then value=true; else value=false; fi
            echo "$unit=$value" >> "$GITHUB_OUTPUT"
          done

  windows:
    name: Windows MSVC x64
    needs: plan
    if: ${{ needs.plan.outputs.windows == 'true' }}
    runs-on: windows-2022
    steps:
      - uses: actions/checkout@v6
      - run: cmake -S . -B build -D@TEST_OPTION_NAME@=ON
      - run: cmake --build build --config Debug --parallel
      - run: ctest --test-dir build -C Debug --output-on-failure

  linux:
    name: Linux GCC x64
    needs: plan
    if: ${{ needs.plan.outputs.linux == 'true' }}
    runs-on: ubuntu-24.04
    steps:
      - uses: actions/checkout@v6
      - run: cmake -S . -B build -D@TEST_OPTION_NAME@=ON
      - run: cmake --build build --config Debug --parallel
      - run: ctest --test-dir build -C Debug --output-on-failure

  macos:
    name: macOS AppleClang arm64
    needs: plan
    if: ${{ needs.plan.outputs.macos == 'true' }}
    runs-on: macos-15
    steps:
      - uses: actions/checkout@v6
      - run: cmake -S . -B build -D@TEST_OPTION_NAME@=ON
      - run: cmake --build build --config Debug --parallel
      - run: ctest --test-dir build -C Debug --output-on-failure

  ci-gate:
    name: CI Gate
    if: ${{ always() }}
    needs: [plan, windows, linux, macos]
    runs-on: ubuntu-24.04
    steps:
      - shell: bash
        env:
          PLAN: ${{ needs.plan.result }}
          WINDOWS: ${{ needs.windows.result }}
          LINUX: ${{ needs.linux.result }}
          MACOS: ${{ needs.macos.result }}
        run: |
          [[ "$PLAN" == success ]]
          [[ "$WINDOWS" == success || "$WINDOWS" == skipped ]]
          [[ "$LINUX" == success || "$LINUX" == skipped ]]
          [[ "$MACOS" == success || "$MACOS" == skipped ]]
