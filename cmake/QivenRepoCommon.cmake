cmake_minimum_required(VERSION 3.28)

function(qiven_require variable)
    if(NOT DEFINED ${variable} OR "${${variable}}" STREQUAL "")
        message(FATAL_ERROR "Required variable ${variable} is missing")
    endif()
endfunction()

function(qiven_validate_value variable)
    qiven_require(${variable})
    if("${${variable}}" MATCHES "[\r\n\"]")
        message(FATAL_ERROR "${variable} contains an unsupported character")
    endif()
endfunction()

function(qiven_render source destination)
    get_filename_component(parent "${destination}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    if(destination MATCHES "\\.(cmd|bat)$")
        configure_file("${source}" "${destination}" @ONLY NEWLINE_STYLE CRLF)
    else()
        configure_file("${source}" "${destination}" @ONLY NEWLINE_STYLE LF)
    endif()
endfunction()

function(qiven_hash path output)
    if(EXISTS "${path}" AND NOT IS_DIRECTORY "${path}")
        file(SHA256 "${path}" value)
        set(${output} "${value}" PARENT_SCOPE)
    else()
        set(${output} "MISSING" PARENT_SCOPE)
    endif()
endfunction()

function(qiven_state_key relative output)
    string(SHA256 key "${relative}")
    set(${output} "QIVEN_HASH_${key}" PARENT_SCOPE)
endfunction()

function(qiven_write_state root source_root)
    set(state "# Generated by qiven-devkit. Do not edit.\nset(QIVEN_STATE_SCHEMA 1)\nset(QIVEN_TEMPLATE_VERSION \"${QIVEN_TEMPLATE_VERSION}\")\n")
    foreach(relative IN LISTS QIVEN_MANAGED_FILES)
        qiven_hash("${source_root}/${relative}" hash)
        qiven_state_key("${relative}" key)
        string(APPEND state "set(${key} \"${hash}\")\n")
    endforeach()
    file(WRITE "${root}/.qiven/generated-state.cmake" "${state}")
endfunction()
