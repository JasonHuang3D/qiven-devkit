cmake_minimum_required(VERSION 3.28)

function(qiven_require variable)
    if(NOT DEFINED ${variable} OR "${${variable}}" STREQUAL "")
        message(FATAL_ERROR "Required variable ${variable} is missing")
    endif()
endfunction()

function(qiven_validate_value variable)
    qiven_require(${variable})
    if("${${variable}}" MATCHES "[\r\n\"]")
        message(FATAL_ERROR "${variable} contains an unsupported character")
    endif()
endfunction()

function(qiven_render source destination)
    get_filename_component(parent "${destination}" DIRECTORY)
    file(MAKE_DIRECTORY "${parent}")
    if(destination MATCHES "\\.(cmd|bat)$")
        configure_file("${source}" "${destination}" @ONLY NEWLINE_STYLE CRLF)
    else()
        configure_file("${source}" "${destination}" @ONLY NEWLINE_STYLE LF)
    endif()
endfunction()

function(qiven_hash path output)
    if(EXISTS "${path}" AND NOT IS_DIRECTORY "${path}")
        file(SHA256 "${path}" value)
        set(${output} "${value}" PARENT_SCOPE)
    else()
        set(${output} "MISSING" PARENT_SCOPE)
    endif()
endfunction()

function(qiven_state_key relative output)
    string(SHA256 key "${relative}")
    set(${output} "QIVEN_HASH_${key}" PARENT_SCOPE)
endfunction()

function(qiven_validate_managed_path relative)
    if("${relative}" STREQUAL "" OR IS_ABSOLUTE "${relative}" OR "${relative}" MATCHES "(^|/)\\.\\.(/|$)" OR "${relative}" MATCHES "[\r\n\"]")
        message(FATAL_ERROR "Unsafe managed path: ${relative}")
    endif()
endfunction()

function(qiven_validate_template_kind value)
    if(NOT "${value}" MATCHES "^[A-Za-z0-9][A-Za-z0-9_-]*$")
        message(FATAL_ERROR "Unsafe template kind: ${value}")
    endif()
endfunction()

function(qiven_managed_template_source relative output)
    if(NOT DEFINED QIVEN_MANAGED_SOURCE_ROOTS OR "${QIVEN_MANAGED_SOURCE_ROOTS}" STREQUAL "")
        message(FATAL_ERROR "Template does not define QIVEN_MANAGED_SOURCE_ROOTS")
    endif()
    set(matches "")
    foreach(root_dir IN LISTS QIVEN_MANAGED_SOURCE_ROOTS)
        set(candidate "${root_dir}/${relative}.in")
        if(EXISTS "${candidate}" AND NOT IS_DIRECTORY "${candidate}")
            list(APPEND matches "${candidate}")
        endif()
    endforeach()
    list(LENGTH matches match_count)
    if(NOT match_count EQUAL 1)
        message(FATAL_ERROR "Managed template path must resolve exactly once: ${relative} (matches=${match_count})")
    endif()
    list(GET matches 0 source)
    set(${output} "${source}" PARENT_SCOPE)
endfunction()

function(qiven_render_managed relative destination)
    qiven_managed_template_source("${relative}" source)
    qiven_render("${source}" "${destination}")
endfunction()

function(qiven_write_state root source_root)
    set(state "# Generated by qiven-devkit. Do not edit.\n# Schema 2 records both the managed path set and the generated SHA-256 for each path.\nset(QIVEN_STATE_SCHEMA 2)\nset(QIVEN_TEMPLATE_VERSION \"${QIVEN_TEMPLATE_VERSION}\")\nset(QIVEN_MANAGED_PATHS\n")
    foreach(relative IN LISTS QIVEN_MANAGED_FILES)
        qiven_validate_managed_path("${relative}")
        string(APPEND state "    \"${relative}\"\n")
    endforeach()
    string(APPEND state ")\n")
    foreach(relative IN LISTS QIVEN_MANAGED_FILES)
        qiven_hash("${source_root}/${relative}" hash)
        qiven_state_key("${relative}" key)
        string(APPEND state "set(${key} \"${hash}\")\n")
    endforeach()
    set(output "${root}/.qiven/generated-state.cmake")
    file(CONFIGURE OUTPUT "${output}" CONTENT "${state}" @ONLY NEWLINE_STYLE LF)
    file(READ "${output}" persisted_state)
    if(persisted_state MATCHES "\r")
        message(FATAL_ERROR "generated state must use LF line endings")
    endif()
endfunction()
