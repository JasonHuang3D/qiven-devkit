{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "qiven-cognition-activation-policy-v1",
  "title": "qiven-cognition-activation-policy-v1",
  "description": "CA-1 typed activation rule table. The runtime loader accepts a STRICT BLOCK-STYLE subset with the selector-schema-v1 EXACT vocabulary; unknown enum values fail visibly with line numbers (never silently irrelevant). One canonical owner per rule.",
  "type": "object",
  "required": ["schema_version", "rules"],
  "properties": {
    "schema_version": { "const": 1 },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "required": ["rule_id", "priority_class", "lifecycle", "source", "selectors", "expected_controls", "independent_evidence"],
        "properties": {
          "rule_id": { "type": "string", "pattern": "^[A-Z0-9-]+$" },
          "priority_class": { "enum": ["P0-core", "P1-protected", "P2-required", "P3-supporting", "P4-on-demand"] },
          "lifecycle": { "enum": ["active", "superseded", "legacy", "retired"] },
          "source": {
            "type": "object",
            "required": ["repository", "path", "anchor"],
            "properties": {
              "repository": { "type": "string" },
              "path": { "type": "string" },
              "anchor": { "type": "string" }
            }
          },
          "selectors": {
            "type": "object",
            "properties": {
              "phases": { "type": "array", "items": { "enum": ["specify", "design", "implementation", "review", "acceptance", "all"] } },
              "risk": { "type": "array", "items": { "enum": ["R0", "R1", "R2", "R3", "all"] } },
              "repositories": { "type": "array", "items": { "type": "string" } },
              "path_prefixes": { "type": "array", "items": { "type": "string" } },
              "languages": { "type": "array", "items": { "enum": ["cpp", "python", "batch", "cmake", "markdown", "yaml"] } },
              "boundary_kinds": { "type": "array", "items": { "enum": ["ownership", "lifetime", "representation", "serialization", "ipc", "persistence", "concurrency", "platform", "external-contract", "security", "process-custody", "filesystem", "git", "cognition", "governance", "tooling", "human-interface"] } },
              "explicit_ids": { "type": "array", "items": { "type": "string" } }
            }
          },
          "expected_controls": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "independent_evidence": { "type": "array", "items": { "enum": ["mechanical", "environmental", "fresh-cognitive", "owner-boundary"] } },
          "explicit_ids": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
