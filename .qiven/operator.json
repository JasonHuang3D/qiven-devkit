{
  "schema_version": 1,
  "repository_name": "qiven-devkit",
  "default_gate": "local",
  "tasks": {
    "exact-head": {
      "builtin": "exact_head"
    },
    "check-toolchain": {
      "argv": [
        "{python}",
        "tools/check_toolchain.py"
      ]
    },
    "cmd-control-flow": {
      "argv": [
        "{cmake}",
        "-DDEVKIT_ROOT={root}",
        "-P",
        "tools/cmd-control-flow-test.cmake"
      ]
    },
    "adoption-missing-sync": {
      "argv": [
        "{cmake}",
        "-DDEVKIT_ROOT={root}",
        "-P",
        "tools/adoption-missing-sync-test.cmake"
      ]
    },
    "operator-tests": {
      "argv": [
        "{python}",
        "tools/operator-test.py"
      ]
    },
    "devkit-regression": {
      "argv": [
        "{cmake}",
        "-DDEVKIT_ROOT={root}",
        "-DQIVEN_TOOLCHAIN_ROOT_TEST={toolchain_root}",
        "-P",
        "tools/test.cmake"
      ]
    },
    "diff-check": {
      "builtin": "git_diff_check",
      "base": "origin/main"
    },
    "clean-tree": {
      "builtin": "git_clean_tree"
    },
    "commit-subjects": {
      "argv": [
        "{python}",
        "tools/check_commit_subjects.py"
      ]
    },
    "merge-proof": {
      "builtin": "gate_proof",
      "gate": "local"
    },
    "router-tests": {
      "argv": [
        "{python}",
        "tools/hook_exec_router_test.py"
      ]
    },
    "workspace-schemas-tests": {
      "argv": [
        "{python}",
        "tools/workspace_schemas_test.py"
      ]
    }
  },
  "gates": {
    "local": [
      "check-toolchain",
      "cmd-control-flow",
      "adoption-missing-sync",
      "operator-tests",
      "router-tests",
      "workspace-schemas-tests",
      "commit-subjects",
      "devkit-regression",
      "diff-check",
      "clean-tree"
    ]
  },
  "ci": {}
}
